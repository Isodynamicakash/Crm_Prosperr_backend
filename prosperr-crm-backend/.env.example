# Copy to .env (git-ignored) for local development. On Render, set these as environment variables instead.
# Optional AI helpers: voice note -> call log. Leave blank to switch AI off.
SARVAM_API_KEY=
# Not used by the app yet; reserved for a future voice demo.
ELEVENLABS_API_KEY=
# Google Calendar + Gmail (each user clicks "Connect Google"). OAuth client of type "Web application".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an "Authorised redirect URI" on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081/api/integrations/google/callback
# 64 hex chars; encrypts stored Google refresh tokens. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# true = clients get the Calendar invite too; false = only the AE and BDR.
GOOGLE_CALENDAR_INVITE_CLIENTS=false
